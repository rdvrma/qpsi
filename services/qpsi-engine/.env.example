# Q-Psi Engine Configuration (Example)
QPSI_ENGINE_ENV=development
QPSI_DATABASE_URL=sqlite:///./qpsi_world.db
QPSI_ENABLE_RESET=true
QPSI_HOST=0.0.0.0
QPSI_PORT=8000

# W&B Weave Experimental Observability (Optional)
# Telemetry is OFF by default. Set QPSI_WEAVE_ENABLED=true to enable.
QPSI_WEAVE_ENABLED=false
QPSI_WEAVE_PROJECT=q-psi/qpsi-classical-baseline
WANDB_API_KEY=
